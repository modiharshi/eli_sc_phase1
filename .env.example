# Copy to .env (git-ignored). infra/pg_setup.sh generates real values automatically.
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_READONLY_PASSWORD=change-me
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=eli
# Created by infra/pg_setup.sh for the web app's limited write role:
POSTGRES_APP_PASSWORD=change-me
# Dev convenience for tests/shots (the local admin login); delete it and use your own password in real use:
ELI_ADMIN_PASSWORD=change-me
# Stage 9 (LLM features, OpenRouter). Not used yet:
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
# Optional: where nightly dumps go (default /var/backups/eli), web port (default 8000)
ELI_BACKUP_DIR=/var/backups/eli
ELI_PORT=8000
